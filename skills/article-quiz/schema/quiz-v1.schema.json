{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collegeville.github.io/article-quiz/schema/quiz-v1.schema.json",
  "title": "Article Quiz question file, schema version 1",
  "description": "A Take the Challenge quiz for one paper. Rules a JSON Schema cannot express (single has exactly one correct choice, multi has two or more, quotes appear in the paper) are enforced by scripts/validate_quiz.py.",
  "type": "object",
  "required": ["schema_version", "generated_by", "generated_on", "paper", "questions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "generated_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "paper": {
      "type": "object",
      "required": ["title", "authors", "doi", "pdf_url", "video_url"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "doi": { "type": "string", "pattern": "^(10\\.\\S+/\\S+)?$" },
        "pdf_url": { "type": "string" },
        "video_url": { "type": "string" }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": ["id", "type", "theme", "prompt", "choices", "explanation", "quote", "location"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^q[0-9]+$" },
        "type": { "enum": ["single", "multi"] },
        "theme": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "choices": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/choice" }
        },
        "explanation": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "location": { "type": "string" }
      }
    },
    "choice": {
      "type": "object",
      "required": ["id", "text", "correct"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]$" },
        "text": { "type": "string", "minLength": 1 },
        "correct": { "type": "boolean" }
      }
    }
  }
}
